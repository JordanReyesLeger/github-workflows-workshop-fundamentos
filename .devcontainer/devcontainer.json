{
  "name": "Taller de GitHub Actions · Contoso Biker",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "github.vscode-github-actions",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "dotnet restore TallerWorkflows.sln",
  "remoteUser": "vscode"
}